# Frontend build-time variables (VITE_ prefix = bundled into the app).
#
# With the Vercel /api rewrite (see vercel.json) the app talks to the backend
# same-origin, so you normally DON'T need to set anything here.

# Only override if you skip the Vercel rewrite and want the app to call the
# backend directly (this then requires CORS_ORIGIN on the backend):
# VITE_API_BASE=https://transit-api.tranzor.io/api

# Optional — must match the backend's DAILY_WALLET_LIMIT:
VITE_DAILY_WALLET_LIMIT=3000
